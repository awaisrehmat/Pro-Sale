CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

DEFAULT_USER_NAME=Admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=password
SEED_DEMO_DATA=false

VITE_APP_NAME="${APP_NAME}"
